package codegen

import "core:fmt"
import "core:strings"

// Returned source uses context.allocator, as do the other language emitters.
emit_gleam :: proc(interface: ^Interface) -> string {
	b: strings.Builder
	import_paths := GLEAM_IMPORT_PATHS
	fmt.sbprintf(&b, "//// Generated by Glodin. Edit the Odin interface instead.\n\n")
	for required, name in interface.gleam_imports {
		if required {
			fmt.sbprintf(&b, "import %s\n", import_paths[name])
		}
	}
	fmt.sbprintf(&b, "\n")
	for declaration in interface.types {
		emit_gleam_type(&b, declaration)
		fmt.sbprintf(&b, "\n")
	}
	for function in interface.functions {
		fmt.sbprintf(
			&b,
			"@external(erlang, \"%s\", \"%s\")\npub fn %s(",
			interface.module,
			function.wire_name,
			function.wire_name,
		)
		for parameter in function.parameters {
			switch parameter.kind {
			case .Environment:
			// Environment parameters are supplied by the NIF wrapper.
			case .Value:
				if parameter.wire_index > 0 {
					fmt.sbprintf(&b, ", ")
				}
				fmt.sbprintf(&b, "%s: %s", parameter.name, parameter.gleam_type)
			}
		}
		fmt.sbprintf(&b, ") -> %s\n\n", function.gleam_result)
	}
	return strings.to_string(b)
}

@(private)
emit_gleam_type :: proc(b: ^strings.Builder, declaration: Type_Declaration) {
	switch declaration.kind {
	case .External:
		fmt.sbprintf(b, "pub type %s\n", declaration.name)
	case .Alias:
		fmt.sbprintf(b, "pub type %s = %s\n", declaration.name, declaration.alias)
	case .Tuple:
		fmt.sbprintf(b, "pub type %s = #(\n", declaration.name)
		for field in declaration.fields {
			fmt.sbprintf(b, "  %s,\n", field.type)
		}
		fmt.sbprintf(b, ")\n")
	case .Custom:
		fmt.sbprintf(b, "pub type %s {{\n", declaration.name)
		for constructor in declaration.constructors {
			fmt.sbprintf(b, "  %s", constructor.name)
			if len(constructor.fields) > 0 {
				fmt.sbprintf(b, "(")
				if constructor.multiline {
					fmt.sbprintf(b, "\n")
				}
				for field, index in constructor.fields {
					if constructor.multiline {
						fmt.sbprintf(b, "    ")
					} else if index > 0 {
						fmt.sbprintf(b, ", ")
					}
					if field.name != "" {
						fmt.sbprintf(b, "%s: ", field.name)
					}
					fmt.sbprintf(b, "%s", field.type)
					if constructor.multiline {
						fmt.sbprintf(b, ",\n")
					}
				}
				if constructor.multiline {
					fmt.sbprintf(b, "  ")
				}
				fmt.sbprintf(b, ")")
			}
			fmt.sbprintf(b, "\n")
		}
		fmt.sbprintf(b, "}}\n")
	}
}
