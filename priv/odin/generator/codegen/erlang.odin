package codegen

import "core:fmt"
import "core:strings"

emit_erlang :: proc(interface: ^Interface) -> string {
	b: strings.Builder
	fmt.sbprintf(
		&b,
		"%%%% Generated by Glodin.\n-module(%s).\n-vsn(\"unbuilt\").\n-on_load(glodin_init/0).\n-export([",
		interface.module,
	)
	for function, index in interface.functions {
		if index > 0 {
			fmt.sbprintf(&b, ", ")
		}
		fmt.sbprintf(&b, "%s/%d", function.wire_name, function.arity)
	}
	fmt.sbprintf(
		&b,
		"]).\n\nglodin_init() ->\n  Path = filename:join([code:priv_dir(%s), \"native\", \"%s\"]),\n  erlang:load_nif(Path, 0).\n\n",
		interface.app,
		interface.module,
	)
	for function in interface.functions {
		fmt.sbprintf(&b, "%s(", function.wire_name)
		for index in 0 ..< function.arity {
			if index > 0 {
				fmt.sbprintf(&b, ", ")
			}
			fmt.sbprintf(&b, "_A%d", index)
		}
		fmt.sbprintf(&b, ") -> erlang:nif_error({{glodin_not_loaded, ?MODULE}}).\n")
	}
	return strings.to_string(b)
}
