package codegen

import "core:fmt"
import "core:strings"

emit_odin :: proc(interface: ^Interface) -> string {
	b: strings.Builder
	fmt.sbprintf(
		&b,
		"// Generated by Glodin.\npackage %s\n\nimport g__ \"glodin:glodin\"\nimport rt__ \"base:runtime\"\nimport mem__ \"core:mem\"\n",
		interface.package_name,
	)
	for imp in interface.imports {
		fmt.sbprintf(&b, "import %s \"%s\"\n_ :: %s\n", imp.name, imp.path, imp.name)
	}
	for function in interface.functions {
		emit_odin_function(&b, function)
	}
	emit_odin_lifecycle(&b, interface)
	if len(interface.codecs) > 0 {
		fmt.sbprintf(
			&b,
			"\n@(init)\nglodin_register_codecs :: proc \"contextless\" () {{\n\tcontext = rt__.default_context()\n",
		)
		for codec in interface.codecs {
			switch registration in codec {
			case Value_Codec:
				fmt.sbprintf(
					&b,
					"\tg__.register_codec(%s, {{mode = .%s, tag = \"%s\"}})\n",
					registration.type,
					registration.mode,
					registration.tag,
				)
			case Resource_Codec:
				fmt.sbprintf(&b, "\tg__.register_resource_codec(%s)\n", registration.type)
			case Json_Codec:
				fmt.sbprintf(&b, "\tg__.register_json_codec(%s)\n", registration.type)
			}
		}
		fmt.sbprintf(&b, "}}\n")
	}
	return strings.to_string(b)
}

@(private)
emit_odin_function :: proc(b: ^strings.Builder, function: Function) {
	fmt.sbprintf(
		b,
		"\n@(export)\nglodin_nif_%s :: proc \"c\" (env: ^g__.Env, argc: i32, argv: [^]g__.Term) -> g__.Term {{\n",
		function.name,
	)
	fmt.sbprintf(
		b,
		"\tcontext = rt__.default_context()\n\tarena: mem__.Dynamic_Arena\n\tmem__.dynamic_arena_init(&arena)\n\tdefer mem__.dynamic_arena_destroy(&arena)\n\tcontext.allocator = mem__.dynamic_arena_allocator(&arena)\n\tcontext.temp_allocator = context.allocator\n\tif argc != %d {{\n\t\treturn g__.badarg(env)\n\t}}\n",
		function.arity,
	)
	args: strings.Builder
	defer strings.builder_destroy(&args)
	for parameter, index in function.parameters {
		if index > 0 {
			fmt.sbprintf(&args, ", ")
		}
		switch parameter.kind {
		case .Environment:
			fmt.sbprintf(&args, "env")
		case .Value:
			fmt.sbprintf(
				b,
				"\ta%d, ok%d := g__.decode(env, argv[%d], %s)\n\tif !ok%d {{\n\t\treturn g__.badarg(env)\n\t}}\n",
				parameter.wire_index,
				parameter.wire_index,
				parameter.wire_index,
				parameter.odin_type,
				parameter.wire_index,
			)
			fmt.sbprintf(&args, "a%d", parameter.wire_index)
		}
	}
	if function.returns_value {
		fmt.sbprintf(
			b,
			"\tresult := %s(%s)\n\treturn g__.encode(env, result)\n}}\n",
			function.name,
			strings.to_string(args),
		)
	} else {
		fmt.sbprintf(
			b,
			"\t%s(%s)\n\treturn g__.Term(g__.atom(env, \"nil\"))\n}}\n",
			function.name,
			strings.to_string(args),
		)
	}
}

@(private)
emit_odin_lifecycle :: proc(b: ^strings.Builder, interface: ^Interface) {
	fmt.sbprintf(b, "\nglodin_prepare_resources :: proc(env: ^g__.Env) -> bool {{\n")
	for resource, index in interface.resources {
		fmt.sbprintf(
			b,
			"\t_, resource_ok%d := g__.resource_open(env, \"%s\", %s)\n\tif !resource_ok%d {{\n\t\treturn false\n\t}}\n",
			index,
			resource.tag,
			resource.type,
			index,
		)
	}
	fmt.sbprintf(
		b,
		"\treturn true\n}}\n\n@(export)\nglodin_on_load :: proc \"c\" (env: ^g__.Env, data: ^rawptr, info: g__.Term) -> i32 {{\n\tcontext = rt__.default_context()\n\tif !glodin_prepare_resources(env) {{\n\t\tg__.shutdown()\n\t\treturn -1\n\t}}\n",
	)
	if interface.lifecycle.load != "" {
		fmt.sbprintf(
			b,
			"\tstatus := %s(env, data, info)\n\tif status != 0 {{\n\t\tg__.shutdown()\n\t}}\n\treturn status\n}}\n",
			interface.lifecycle.load,
		)
	} else {
		fmt.sbprintf(b, "\treturn 0\n}}\n")
	}
	if interface.lifecycle.upgrade != "" {
		fmt.sbprintf(
			b,
			"\n@(export)\nglodin_on_upgrade :: proc \"c\" (env: ^g__.Env, data, old: ^rawptr, info: g__.Term) -> i32 {{\n\tcontext = rt__.default_context()\n\tif !glodin_prepare_resources(env) {{\n\t\tg__.shutdown()\n\t\treturn -1\n\t}}\n\tstatus := %s(env, data, old, info)\n\tif status != 0 {{\n\t\tg__.shutdown()\n\t}}\n\treturn status\n}}\n",
			interface.lifecycle.upgrade,
		)
	} else {
		fmt.sbprintf(
			b,
			"\n@(export)\nglodin_on_upgrade :: proc \"c\" (env: ^g__.Env, data, old: ^rawptr, info: g__.Term) -> i32 {{\n\treturn glodin_on_load(env, data, info)\n}}\n",
		)
	}
	fmt.sbprintf(
		b,
		"\n@(export)\nglodin_on_unload :: proc \"c\" (env: ^g__.Env, data: rawptr) {{\n\tcontext = rt__.default_context()\n\tg__.jobs_shutdown()\n",
	)
	if interface.lifecycle.unload != "" {
		fmt.sbprintf(b, "\t%s(env, data)\n", interface.lifecycle.unload)
	}
	fmt.sbprintf(b, "\tg__.shutdown()\n}}\n")
}
