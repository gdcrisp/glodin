package codegen

import "core:fmt"
import "core:strings"

emit_c :: proc(interface: ^Interface) -> string {
	b: strings.Builder
	fmt.sbprintf(&b, "/* Generated by Glodin. */\n#include \"glodin.c\"\n")
	for function in interface.functions {
		fmt.sbprintf(&b, "extern ERL_NIF_TERM glodin_nif_%s(ErlNifEnv*, int, const ERL_NIF_TERM*);\n", function.name)
	}
	fmt.sbprintf(&b, "static ErlNifFunc glodin_functions[] = {{\n")
	for function in interface.functions {
		fmt.sbprintf(
			&b,
			"  {{\"%s\", %d, glodin_nif_%s, %s}},\n",
			function.wire_name,
			function.arity,
			function.name,
			scheduler_flag(function.scheduler),
		)
	}
	fmt.sbprintf(&b, "}};\n")
	fmt.sbprintf(&b, "extern int glodin_on_load(ErlNifEnv*, void**, ERL_NIF_TERM);\n")
	fmt.sbprintf(&b, "extern int glodin_on_upgrade(ErlNifEnv*, void**, void**, ERL_NIF_TERM);\n")
	fmt.sbprintf(&b, "extern void glodin_on_unload(ErlNifEnv*, void*);\n")
	fmt.sbprintf(
		&b,
		"ERL_NIF_INIT(%s, glodin_functions, glodin_on_load, NULL, glodin_on_upgrade, glodin_on_unload)\n",
		interface.module,
	)
	return strings.to_string(b)
}

@(private)
scheduler_flag :: proc(scheduler: Scheduler) -> string {
	switch scheduler {
	case .Normal:
		return "0"
	case .Dirty_Cpu:
		return "ERL_NIF_DIRTY_JOB_CPU_BOUND"
	case .Dirty_Io:
		return "ERL_NIF_DIRTY_JOB_IO_BOUND"
	}
	panic("invalid scheduler")
}
